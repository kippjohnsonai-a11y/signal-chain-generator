<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  System LaunchDaemon: runs Signal Chain Generator as __USER__ whether or not
  anyone is logged in, and restarts it if it exits. install.sh fills in
  __USER__ and __HOME__ and installs it (docs/mac-mini.md).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stompxl.server</string>
  <key>UserName</key>
  <string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/stompxl/deploy/macos/start-stompxl.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/stompxl.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/stompxl.log</string>
</dict>
</plist>
