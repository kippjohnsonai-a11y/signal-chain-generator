# Mac mini env file for Signal Chain Generator. Copy to ~/.config/stompxl/stompxl.env
# in the account the app runs as, fill in, then: chmod 600. start-stompxl.sh
# refuses to start if other accounts can read it.

# Your Tailscale login (Tailscale app -> your name, or `tailscale status`).
# Only these logins can open the app over the tailnet; everyone else on the
# tailnet gets "private". Comma-separate to allow more than one.
STOMPXL_ALLOWED_LOGINS=REPLACE-you@example.com

# Local port. Tailscale Serve publishes the same number over HTTPS. Kept out of
# the per-user launcher's range (8765 and up), so the old app icon in another
# account can't collide with it.
STOMPXL_PORT=8780

# Optional: the Anthropic key can live here instead of in the app's Settings.
# ANTHROPIC_API_KEY=

# --- Guests: Google sign-in through Cloudflare (docs/guests.md) ---------------
# Leave these out and nothing changes. With them, cloudflared forwards your
# public address to this second local port, and only people Cloudflare Access
# signed in (and listed below) get in. Each guest has their own library.
# STOMPXL_CLOUDFLARE_PORT=8781
# STOMPXL_CF_TEAM_DOMAIN=REPLACE-team.cloudflareaccess.com
# STOMPXL_CF_AUD=REPLACE-application-audience-tag
# Guests' Google emails, comma-separated. They must be in the Access policy too.
# STOMPXL_GUEST_EMAILS=friend@gmail.com,bandmate@gmail.com
# Your own Google email(s): signing in with these opens YOUR library.
# STOMPXL_OWNER_EMAILS=REPLACE-you@gmail.com
# Claude jobs (generate, refine, fork, explain) each guest may run per day on
# your API key. You are never limited.
# STOMPXL_GUEST_DAILY_CLAUDE=25

# --- Send diagnostics (docs/diagnostics.md) ----------------------------------
# A fine-grained GitHub token with only Issues: read and write on the stompxl
# repository. The app's Send diagnostics button opens an issue with it. You can
# paste it in Settings instead of here.
# STOMPXL_DIAGNOSTICS_TOKEN=github_pat_REPLACE
